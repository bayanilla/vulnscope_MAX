# Copy to .env next to compose.yaml. Paths may be absolute (Windows: C:\cases).

# Folder with your logs, Nessus scans and packet captures (mounted read-only at /data)
VULNSCOPE_DATA=./data
# Folder the upload page's Browse button can see, read-only (default: your home folder).
# It appears inside the container at the same path, so /Users/you/Documents/case1 works as typed.
# Windows: your user folder appears as /host; pasted paths like C:\Users\you\Documents\case1 work too.
# To share a whole drive: VULNSCOPE_BROWSE=D:\ and VULNSCOPE_BROWSE_AT=/host.
# External drives on macOS: VULNSCOPE_BROWSE=/Volumes/Evidence (add /Volumes under Docker
# Desktop > Settings > Resources > File sharing first).
# Fixed-folder mode (enclaves, locked-down sites): share only one inbox folder, e.g.
#   VULNSCOPE_BROWSE=/Users/you/VulnScope/inbox   (create it first)
#VULNSCOPE_BROWSE=
#VULNSCOPE_BROWSE_AT=

# Where results and temporary Parquet/DuckDB/Zeek files go (mounted at /runs).
# Plan for about the size of the uncompressed logs, more for large PCAPs.
VULNSCOPE_RUNS=./vulnscope-out

# Browser port on this computer (always bound to 127.0.0.1)
VULNSCOPE_PORT=8080

# 1 = no outbound network use at all (air-gapped enclaves): article previews off.
VULNSCOPE_OFFLINE=0

# Container memory cap, e.g. 16g (0 = no cap). On macOS/Windows Docker Desktop's own VM limit
# (Settings > Resources) also applies; DuckDB sizes itself to whichever is lower.
VULNSCOPE_MEMORY=0
# Optional fixed DuckDB memory, e.g. 8GB or 50%
VULNSCOPE_DUCKDB_MEMORY=

# Image name, e.g. a tag loaded from an offline bundle
VULNSCOPE_IMAGE=vulnscope-max:latest
