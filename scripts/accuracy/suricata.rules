# Harmless test rules for the CI accuracy job: each matches ordinary traffic in brimcap's
# alerts.pcap, so the expected alerts are known in advance. Used with Suricata's built-in event rules.
alert http any any -> any any (msg:"VSTEST web docs host www.centos.org"; http.host; content:"www.centos.org"; classtype:policy-violation; sid:9000001; rev:1;)
alert dns any any -> any any (msg:"VSTEST DNS query security.ubuntu.com"; dns.query; content:"security.ubuntu.com"; nocase; classtype:policy-violation; sid:9000002; rev:1;)
alert http $HOME_NET any -> $HOME_NET any (msg:"VSTEST internal router sysmsg.xml"; http.uri; content:"/sysmsg.xml"; classtype:attempted-recon; sid:9000003; rev:1;)
alert tls any any -> any any (msg:"VSTEST TLS SNI fonts.gstatic.com"; tls.sni; content:"fonts.gstatic.com"; classtype:policy-violation; sid:9000004; rev:1;)
alert http any any -> any any (msg:"VSTEST OCSP POST"; http.method; content:"POST"; http.uri; content:"/ocsp"; classtype:misc-activity; sid:9000005; rev:1;)
